  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "meetingTypeId",
          "startsAt",
          "guestName",
          "guestEmail",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "meetingTypeId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookingInput": {
        "type": "object",
        "required": [
          "meetingTypeId",
          "startsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "meetingTypeId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "MeetingType": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "number",
            "enum": [
              15,
              30,
              45,
              60
            ]
          }
        }
      },
      "MeetingTypeInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "number",
            "enum": [
              15,
              30,
              45,
              60
            ]
          }
        }
      },
      "Slot": {
        "type": "object",
        "required": [
          "startsAt",
          "endsAt",
          "isAvailable"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "isAvailable": {
            "type": "boolean"
          }
