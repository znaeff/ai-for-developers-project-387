{
  "name": "calendar-booking",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "generate": "pnpm generate:openapi && pnpm generate:sdk",
    "generate:openapi": "tsp compile contracts",
    "generate:sdk": "openapi-ts -i ./contracts/openapi/openapi.json -o ./apps/frontend/src/api/generated",
    "generate:check": "node scripts/check-generated.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @app/backend dev",
    "dev:frontend": "pnpm --filter @app/frontend dev",
    "docker:build": "docker build -t calendar-booking:local .",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "docker:run": "docker run --rm -p 3000:3000 calendar-booking:local"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
